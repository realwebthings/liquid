{
  "name": "lightmight",
  "version": "0.1.0",
  "description": "Tiny React/Next state management: ~360 B closure store, opt-in persist, cross-tab, and mutable updates.",
  "license": "MIT",
  "author": "realwebthings",
  "keywords": ["react", "nextjs", "state", "state-management", "store", "hooks", "zustand", "persist", "typescript"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/types.mjs",
    "size": "node scripts/size.mjs",
    "api": "node scripts/api.mjs",
    "api:update": "node scripts/api.mjs --update",
    "verify": "npm run typecheck && npm test && npm run build && npm run size && npm run api",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vanilla": {
      "import": {
        "types": "./dist/vanilla.d.ts",
        "default": "./dist/vanilla.js"
      },
      "require": {
        "types": "./dist/vanilla.d.cts",
        "default": "./dist/vanilla.cjs"
      }
    },
    "./shallow": {
      "import": {
        "types": "./dist/shallow.d.ts",
        "default": "./dist/shallow.js"
      },
      "require": {
        "types": "./dist/shallow.d.cts",
        "default": "./dist/shallow.cjs"
      }
    },
    "./persist": {
      "import": {
        "types": "./dist/persist.d.ts",
        "default": "./dist/persist.js"
      },
      "require": {
        "types": "./dist/persist.d.cts",
        "default": "./dist/persist.cjs"
      }
    },
    "./persist-async": {
      "import": {
        "types": "./dist/persist-async.d.ts",
        "default": "./dist/persist-async.js"
      },
      "require": {
        "types": "./dist/persist-async.d.cts",
        "default": "./dist/persist-async.cjs"
      }
    },
    "./cross-tab": {
      "import": {
        "types": "./dist/cross-tab.d.ts",
        "default": "./dist/cross-tab.js"
      },
      "require": {
        "types": "./dist/cross-tab.d.cts",
        "default": "./dist/cross-tab.cjs"
      }
    },
    "./mutable": {
      "import": {
        "types": "./dist/mutable.d.ts",
        "default": "./dist/mutable.js"
      },
      "require": {
        "types": "./dist/mutable.d.cts",
        "default": "./dist/mutable.cjs"
      }
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "typesVersions": {
    "*": {
      "vanilla": [
        "dist/vanilla.d.ts"
      ],
      "shallow": [
        "dist/shallow.d.ts"
      ],
      "persist": [
        "dist/persist.d.ts"
      ],
      "persist-async": [
        "dist/persist-async.d.ts"
      ],
      "cross-tab": [
        "dist/cross-tab.d.ts"
      ],
      "mutable": [
        "dist/mutable.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  }
}
